# Скопируйте этот файл в .env и заполните. Сам шаблон не переименовывайте — он остаётся образцом.

# Обязательные
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Любая строка из A-Z a-z 0-9 _ - длиной 1..256, например: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me

# Адрес деплоя без слэша на конце (нужен scripts/set_webhook.py)
PUBLIC_URL=https://your-project.vercel.app

# Необязательные
MAX_FRAMES=10
# Таймаут всей обработки, с (функция Vercel живёт до 300 с)
PROCESS_TIMEOUT=270
# Кадры больше этого размера уменьшаются перед обработкой (0 — не уменьшать)
MAX_MEGAPIXELS=16
MAX_FILE_MB=20
# Через запятую; пусто — доступ всем
ALLOWED_USER_IDS=

# Нейросетевой шаг Real-ESRGAN
SR_ENABLED=1
# Лимит времени на нейросеть, с; если прогноз больше — шаг пропускается, результат классический
SR_TIMEOUT=200
SR_TILE=384
SR_MAX_SIDE=1024

# Хранилище (Upstash Redis / Vercel KV). Без него не работает /mode, всё остальное работает.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Размер результата нейросети: auto (маленькие ×4, большие — исходный размер), x4, original
SR_OUTPUT=auto
